 "en": {
  "name": "The Fall of Constantinople",
  "sub": "April 1453 – Before the Walls",
  "blurb": "Young Sultan Mehmed II stands before the walls of Constantinople with an army of 80,000 and giant cannon. Only a few thousand defenders and some Genoese auxiliaries hold the city. Either the thousand-year capital falls, or the Ottoman army breaks itself against the walls.",
  "setup_intro": "April 1453: Sultan Mehmed II marched from Edirne and besieged Constantinople. The city trusts its double walls and the chained Golden Horn, but Ottoman cannon and fleet will decide the fate of walls and harbour.",
  "events": {
   "0": "29 May: Constantinople has fallen. Sultan Mehmed II broke the walls with cannon fire; Constantine XI died on the ramparts as the last emperor. A thousand years of the Eastern Roman Empire come to an end.",
   "1": "Battle of Castillon (17 July): French artillery routs the English army, the last great battle of the Hundred Years' War.",
   "2": "19 October: Bordeaux surrenders; the English are driven from the continent except Calais and the Hundred Years' War ends.",
   "3": "The 42-line Gutenberg Bible is completed: the printing press spreads fast across Europe.",
   "4": "4 June: the Ottoman army takes Athens; the Acropolis, last stronghold of the Florentine Acciaiuoli duchy, will surrender in 1458.",
   "5": "Siege of Belgrade: John Hunyadi and John of Capistrano stop Mehmed's army on the Danube (4-22 July).",
   "6": "11 August: John Hunyadi dies in the plague that broke out in the camp; Hungary's defence is left without a head.",
   "7": "20 June: Smederevo, capital of the Serbian Despotate, surrenders; Serbia becomes an Ottoman province.",
   "8": "29 May: Mystras surrenders and the Despotate of the Morea passes to the Ottomans (the last fortress, Salmenikon, falls in 1461). The last Palaiologoi flee to Italy.",
   "9": "Summer 1461: Sinope surrenders and the Candar beylik comes to an end; on 15 August the Empire of Trebizond surrenders too.",
   "10": "Karaman Bey Ibrahim II dies; a succession fight among his sons opens the door for the Ottomans.",
   "11": "14 August: Pope Pius II dies at Ancona while trying to gather the crusading army; the expedition collapses.",
   "12": "Konya is annexed by the Ottomans: the Karamanid heartland is lost."
  },
  "objectives": {
   "o1": "Survive two years",
   "o2": "Make 2 allies",
   "t1": "Conquer Constantinople",
   "t2": "Grow the state: reach 70 provinces",
   "t3": "Annex the Serbian Despotate",
   "g1": "Withstand the siege: stay alive for 26 weeks",
   "g2": "Ally with Venice or the Papacy",
   "h1": "Make 2 allies",
   "h2": "Keep stability above 50",
   "k1": "Expand Karaman: reach 12 provinces"
  }
 }
