 "en": {
  "name": "Age of the Ottomans",
  "sub": "September 1520 – Suleiman the Magnificent",
  "blurb": "Selim the Grim is dead; young Suleiman takes the throne. Habsburgs, Valois France, the Safavids, Muscovy, Ming China and the Deccan sultanates divide the world. Janissary matchlocks, siege cannon and galleys open the age of an empire.",
  "setup_intro": "September 1520: Sultan Selim has died and twenty-six-year-old Suleiman ascends the Ottoman throne. The Habsburgs and Valois France prepare to fight over Italy; in the east Shah Ismail watches the Ottomans from Tabriz.",
  "events": {
   "0": "Stockholm Bloodbath: Christian II of Denmark executed Swedish nobles; a revolt is brewing.",
   "1": "Magellan's expedition reaches the Philippines.",
   "2": "Diet of Worms: Martin Luther stands before the emperor; the Reformation storm grows in Germany.",
   "3": "The Habsburg–Valois war begins: Charles V and Francis I take up arms for Italy.",
   "4": "The Ottoman army besieges and takes Belgrade; the gate to Hungary is open.",
   "5": "Cortés takes Tenochtitlan; the Aztec Alliance collapses.",
   "6": "Rhodes surrenders to the Ottomans after a six-month defence by the Knights.",
   "7": "Gustav Vasa is proclaimed King of Sweden; the Kalmar Union is effectively dissolved.",
   "8": "Shah Ismail of Persia dies; his young son Tahmasp succeeds and the Qizilbash beys quarrel.",
   "9": "Battle of Pavia: Francis I of France is taken prisoner.",
   "10": "Battle of Panipat: Babur defeats Ibrahim Lodi, the Sultan of Delhi; the Mughal state is born.",
   "11": "Battle of Mohács: the Hungarian army is destroyed in an hour and King Louis II dies.",
   "12": "Sack of Rome: Charles V's troops plunder the city; Italy is shaken.",
   "13": "The Ottoman army stands before Vienna: the Habsburg capital is besieged.",
   "14": "In Adal, Ahmad Gran launches a great invasion of Ethiopia.",
   "15": "Pizarro ambushes the Inca emperor Atahualpa at Cajamarca.",
   "16": "The Ottomans take Baghdad; Iraq passes from the Safavids.",
   "17": "Battle of Preveza: Barbarossa defeats the Holy League fleet; the Mediterranean becomes an Ottoman lake.",
   "18": "Buda is made an Ottoman province; Hungary is split in three.",
   "19": "Peace: a five-year truce is signed between the Ottomans and the Habsburgs.",
   "20": "Charles V abdicates; the Habsburg inheritance is split into two branches.",
   "21": "Treaty of Cateau-Cambrésis ends the Habsburg–Valois wars.",
   "22": "The Siege of Malta begins: the Ottoman fleet surrounds the Knights' island.",
   "23": "Suleiman the Magnificent dies at Szigetvár."
  },
