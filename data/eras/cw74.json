 "en": {
  "name": "Ayşe Goes on Holiday",
  "sub": "July 1974 – Operation Cyprus",
  "blurb": "15 July 1974: Athens' junta staged a coup on Cyprus and Makarios was overthrown. Ecevit returned from London empty-handed; Greece, Britain, the US and the USSR are on stage. Will 'Ayşe' go on holiday — and will the island be split in two?",
  "setup_intro": "15 July 1974: the National Guard, backed by the Athens junta, overthrew Makarios and Nikos Sampson became 'president'. Guarantor Turkey, Britain and Greece are on edge; Ecevit's government came back from London empty-handed. Will a landing on the island be ordered?",
  "events": {
   "0": "Athens' junta toppled Makarios to force 'Enosis' on Cyprus; the island is at the centre of a diplomatic storm.",
   "1": "Watergate: Nixon resigned and Gerald Ford became US president.",
   "2": "The Greek junta collapsed; Karamanlis returned from Paris to form a government.",
   "3": "Ecevit's coalition broke up: a government crisis begins in Turkey.",
   "4": "In Ethiopia, Emperor Haile Selassie was deposed.",
   "5": "Greece's first free election after the junta: Karamanlis's New Democracy won.",
   "6": "Saigon fell: the Vietnam War ended in a Northern victory.",
   "7": "Civil war broke out in Lebanon.",
   "8": "Helsinki Final Act signed: East and West accept the inviolability of borders.",
   "9": "Franco died; Spain's transition to democracy begins.",
   "10": "Sismik-1 crisis: a research ship in the Aegean brings Turkey and Greece close to war again.",
   "11": "Mao Zedong died; a power struggle begins in China.",
   "12": "Ecevit won the election and became prime minister again; Cyprus was at the heart of the 'national cause' campaign."
  },
  "objectives": {
   "k1": "Survive two years",
   "k2": "Make 3 allies",
   "kt1": "Capture Nicosia",
   "kt2": "Take the Famagusta (Maraş) area",
   "kt3": "Keep stability above 50",
   "kg1": "Stay out of war with Turkey (keep the peace)",
   "kg2": "Raise post-junta stability above 45",
   "kc1": "Hold Nicosia",
   "kc2": "Keep stability above 40",
   "kn1": "Hold Famagusta",
   "kn2": "Add Nicosia to the Turkish zone",
   "ku1": "Mediate on Cyprus for 52 weeks without going to war",
   "ka1": "Keep two NATO members from war for 52 weeks",
   "kr1": "Make 6 allies"
  }
 }
